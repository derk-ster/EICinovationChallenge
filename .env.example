# ─────────────────────────────────────────────────────────────────────────────
# EIC Innovation Challenge — environment variables
# Copy to .env.local for local development. Never commit real values.
# All of these are read on the server only; none are exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Storage backend: "supabase" (production) or "local" (isolated dev store in .data/).
# If unset: Supabase is used when its variables exist; otherwise local in development.
# Production never falls back to local storage.
EIC_DATA_BACKEND=local

# Only for testing a production build on your own machine with the local store.
# Leave unset in real deployments.
# EIC_ALLOW_LOCAL_STORE=true

# Signs officer sessions, email-verification proofs and private file links.
# Required in production: at least 32 random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=

# Supabase project (Settings → API). The service-role key bypasses row-level
# security: keep it server-side only (never prefix with NEXT_PUBLIC_).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=submission-files

# Mark everything written by this deployment as test data (use on staging projects).
# EIC_TEST_DATA=true

# Upload limits in MB. Supabase's Free plan caps files at 50 MB; raise both the
# bucket limit and these values only on a plan that allows larger files.
MAX_PROTOTYPE_MB=50
MAX_VIDEO_MB=50

# Where the local store keeps its JSON database and uploads (git-ignored).
# EIC_LOCAL_DATA_DIR=.data
